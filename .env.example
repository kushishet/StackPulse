# StackPulse Environment Configuration

# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database configuration:
# Provide a PostgreSQL connection string to use PostgreSQL:
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/stackpulse

# Optional GitHub Personal Access Token (PAT)
# Unauthenticated requests are limited to 60 requests/hr.
# Adding a PAT increases your rate limit to 5,000 requests/hr!
GITHUB_TOKEN=

# JWT Authentication Secret
JWT_SECRET=supersecret_stackpulse_jwt_token_key_change_in_production_2026

# Cache TTL in minutes for GitHub Developer & Repo data (default: 60 minutes)
CACHE_TTL_MINUTES=60
